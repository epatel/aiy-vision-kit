+/* Maps the atomic PWM API onto the legacy config/enable/disable steps.
+ * pwm->state still holds the previous state while apply() runs. */
+static int aiy_pwm_apply(struct pwm_chip *chip, struct pwm_device *pwm,
+			 const struct pwm_state *state)
+{
+	int err;
+
+	if (state->polarity != PWM_POLARITY_NORMAL)
+		return -EINVAL;
+
+	if (!state->enabled) {
+		if (pwm->state.enabled)
+			aiy_pwm_disable(chip, pwm);
+		return 0;
+	}
+
+	if (state->period > INT_MAX || state->duty_cycle > state->period)
+		return -EINVAL;
+
+	err = aiy_pwm_config(chip, pwm, state->duty_cycle, state->period);
+	if (err)
+		return err;
+
+	if (!pwm->state.enabled)
+		return aiy_pwm_enable(chip, pwm, state->period);
+	return 0;
+}
