+def _kernel_gpio_number(bcm_gpio):
+    """Returns the kernel's global number for a BCM GPIO.
+
+    The SoC gpiochip base moved from 0 to 512 in kernel 6.6, and pwm-soft takes
+    global numbers.
+    """
+    for chip in glob.glob('/sys/class/gpio/gpiochip*'):
+        try:
+            with open(os.path.join(chip, 'label')) as f:
+                if f.read().strip() != 'pinctrl-bcm2835':
+                    continue
+            with open(os.path.join(chip, 'base')) as f:
+                return int(f.read()) + bcm_gpio
+        except (OSError, ValueError):
+            continue
+    return bcm_gpio
